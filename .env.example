# Copy to .env; never commit the real key.
# Required only for --config examples/pipeline/harbor.json
OPENAI_API_KEY=
# Model name accepted by your API endpoint, without an openai/ prefix.
SCI_PIPELINE_MODEL=
# Optional. Empty uses the official OpenAI endpoint.
# Use the API base (e.g. https://provider.example/v1), not /v1/responses.
OPENAI_BASE_URL=

# Optional, only when Docker builds/containers require an outbound proxy.
# Must be reachable INSIDE containers, without embedded credentials.
# Example: http://host.docker.internal:17897 (replace with your actual port).
# Do not use localhost/127.0.0.1 for a proxy running on the host.
SCI_PIPELINE_CONTAINER_PROXY=
SCI_PIPELINE_CONTAINER_NO_PROXY=localhost,127.0.0.1

# No Codex login/auth.json is used. Keys are injected into role containers only.
# Concurrency, timeouts, task counts and versions belong in the run JSON, not here.

# Required for real sci-source searches; mock does not read credentials.
TAVILY_API_KEY=
